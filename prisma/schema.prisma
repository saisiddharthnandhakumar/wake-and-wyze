generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PreOrder {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  flavor         String
  quantity       Int
  unitPricePaise Int             @default(129900)
  subtotalPaise  Int
  discountPaise  Int             @default(0)
  totalPaise     Int
  couponCode     String?
  name           String
  phone          String
  email          String
  address        String
  city           String
  state          String
  pincode        String
  paymentStatus  String          @default("pending")
  utrReference   String?
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  paymentMethod      String?
  paymentErrorJson   String?
  razorpayCustomerId String?
  razorpayInvoiceId  String?        @unique
  statusLogJson      String?
  createdAt      DateTime        @default(now())
  paidAt         DateTime?
  updatedAt      DateTime        @updatedAt
  items          PreOrderItem[]

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([phone])
  @@index([razorpayCustomerId])
}

model PreOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  flavor         String
  quantity       Int
  unitPricePaise Int      @default(129900)
  createdAt      DateTime @default(now())
  order          PreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
