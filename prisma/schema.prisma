generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PreOrder {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  flavor         String
  quantity       Int
  unitPricePaise Int      @default(129900)
  subtotalPaise  Int
  discountPaise  Int      @default(0)
  totalPaise     Int
  couponCode     String?
  name           String
  phone          String
  email          String
  address        String
  city           String
  state          String
  pincode        String
  paymentStatus  String   @default("pending")
  utrReference   String?
  statusLogJson  String?
  createdAt      DateTime @default(now())
  paidAt         DateTime?
  updatedAt      DateTime @updatedAt

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([phone])
}
